# Copy this file to `.env` and fill in real values.
# Do not put real secrets in git.

NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"
# Next.js — use your live Vercel URL in production (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required for cron job authentication (trial expiration check)
# Generate a strong random string (e.g., openssl rand -base64 32)
CRON_SECRET="your-secure-random-secret-key-here"

# Optional — distributed rate limiting (falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — error monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Optional — YouTube Data API key for reliable exercise form demos
# (falls back to public Piped search if unset)
YOUTUBE_API_KEY=""

# Optional — WorkoutDB / WorkoutX-compatible key for exercise GIF animations
# Sent as X-API-Key and X-WorkoutX-Key. Free GIFs still work without this via ExerciseDB OSS.
WORKOUTDB_API_KEY=""

# Optional — RapidAPI key for ExerciseDB V2 (MP4 videos + higher-res GIFs)
EXERCISEDB_RAPIDAPI_KEY=""

# Required for accurate near-me km + address search (Google Maps Platform)
# Enable in Google Cloud: Geocoding API, Distance Matrix API
# Use a server key (IP restrict in production). Billing must be enabled.
GOOGLE_MAPS_API_KEY=""

# Optional — Brevo (Sendinblue) for promotion / newsletter emails
# Without these, promotion emails are only queued (not delivered)
BREVO_API_KEY=""
NEWSLETTER_FROM_EMAIL="Forge Gym <noreply@your-verified-domain.com>"

# Supabase Auth transactional emails (signup confirmation, password reset,
# magic link) go through Supabase's SMTP by default (4 emails/hour free limit).
# To send them via Brevo instead, configure Supabase — no app env var needed:
#   1. Brevo dashboard → SMTP & API → SMTP Keys → create a key
#   2. Supabase dashboard → Authentication → Sign In / Providers → Email
#      → enable "Custom SMTP" and enter:
#        Host: smtp-relay.brevo.com
#        Port: 587 (TLS) or 465 (SSL)
#        Username: your Brevo account login email
#        Password: the Brevo SMTP key from step 1
#   3. Sender details must match a domain verified in Brevo (Domains).

# Optional — public contact page (pipe-separated for multiple lines/values)
NEXT_PUBLIC_CONTACT_ADDRESS="Forge Gym Platform|Partner gyms across Pakistan"
NEXT_PUBLIC_CONTACT_PHONES="+92 300 0000000"
NEXT_PUBLIC_CONTACT_EMAILS="hello@forgegym.app|support@forgegym.app"
NEXT_PUBLIC_CONTACT_HOURS="Support: Mon–Sat 9am – 8pm|Partner gyms: hours vary by location"
NEXT_PUBLIC_CONTACT_MAP_EMBED=""

# Copy this file to `.env` and fill in real values.
# Do not put real secrets in git.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"
# Next.js — use your live Vercel URL in production (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — distributed rate limiting (falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — error monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Optional — YouTube Data API key for reliable exercise form demos
# (falls back to public Piped search if unset)
YOUTUBE_API_KEY=""

# Newsletter / promotions email (Brevo — https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=""
# Verified sender in Brevo: either bare email or "Forge Gym <noreply@yourdomain.com>"
NEWSLETTER_FROM_EMAIL="Forge Gym <noreply@yourdomain.com>"
# Optional — HMAC secret for unsubscribe links (falls back to service role key)
NEWSLETTER_UNSUB_SECRET=""
